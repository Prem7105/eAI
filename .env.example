# Optional LLM credentials; leave empty for template reports.
GEMINI_API_KEY=
GROQ_API_KEY=
# Set provider model identifiers before enabling an LLM.
GEMINI_MODEL=
GROQ_MODEL=
# Default mode never executes recovery actions.
ETERNALAI_MODE=watch-only
# Generate separate credentials locally before starting services.
CONTROL_TOKEN=
EVALUATOR_TOKEN=
